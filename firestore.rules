rules_version = '2';

// Reglas de seguridad de UniStreak.
// Pégalas en Firebase Console > Firestore Database > Reglas, o despliega con:
//   npx firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones auxiliares ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function sessionPath(uid, sessionId) {
      return /databases/$(database)/documents/users/$(uid)/sessions/$(sessionId);
    }

    // Duración de la sesión que se crea en esta misma escritura; 0 si no hay una sesión nueva.
    // Así los totales solo pueden subir lo que dura una sesión real, y una sola vez.
    function newSessionDuration(uid, sessionId) {
      return sessionId is string
          && !exists(sessionPath(uid, sessionId))
          && existsAfter(sessionPath(uid, sessionId))
        ? getAfter(sessionPath(uid, sessionId)).data.duration
        : 0;
    }

    // Materia de la sesión que se crea en esta misma escritura; null si no tiene.
    function newSessionSubject(uid, sessionId) {
      return sessionId is string
          && !exists(sessionPath(uid, sessionId))
          && existsAfter(sessionPath(uid, sessionId))
          && 'subjectId' in getAfter(sessionPath(uid, sessionId)).data
        ? getAfter(sessionPath(uid, sessionId)).data.subjectId
        : null;
    }

    // ---------- Usuarios: users/{uid} ----------
    match /users/{uid} {
      function keysOk(data) {
        return data.keys().hasOnly([
          'name', 'universityId', 'universityName',
          'totalMinutes', 'sessions', 'currentStreak', 'bestStreak',
          'lastSessionDate', 'lastSessionId', 'createdAt', 'updatedAt',
          'subjectMinutes', 'premium', 'premiumSince', 'goals',
          'careerId', 'favoriteSubjects', 'customSubjects'
        ]);
      }

      // Metas semanales por materia: { materia: minutos }, hasta 20 materias.
      // Las reglas no pueden recorrer un map; los valores los valida la app (no afectan el ranking).
      function isGoalsEdit() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['goals', 'updatedAt'])
          && request.resource.data.goals is map
          && request.resource.data.goals.size() <= 20;
      }

      // Materias favoritas (lista de ids) y personalizadas ({ "custom-x": "Nombre" }), hasta 20 de cada una
      function isSubjectPrefsEdit() {
        let after = request.resource.data;
        return after.diff(resource.data).affectedKeys().hasOnly(['favoriteSubjects', 'customSubjects', 'updatedAt'])
          && after.get('favoriteSubjects', []) is list
          && after.get('favoriteSubjects', []).size() <= 20
          && after.get('customSubjects', {}) is map
          && after.get('customSubjects', {}).size() <= 20;
      }

      // DEMO: Premium se activa desde el cliente. Cerrar esta regla cuando exista pasarela de pago.
      function isPremiumToggle() {
        let after = request.resource.data;
        return after.diff(resource.data).affectedKeys().hasOnly(['premium', 'premiumSince', 'updatedAt'])
          && after.premium is bool
          && (after.premium ? after.premiumSince == request.time : after.premiumSince == null);
      }

      // Minutos por materia: solo sube la materia de la sesión nueva, exactamente su duración
      function subjectMinutesOk(uid) {
        let after = request.resource.data;
        let before = resource.data;
        let sid = newSessionSubject(uid, after.lastSessionId);
        let beforeMap = before.get('subjectMinutes', {});
        // Las materias personalizadas (custom-*) no cuentan en el ranking por materia
        return sid == null || sid.matches('^custom-.*')
          ? after.get('subjectMinutes', {}) == beforeMap
          : after.subjectMinutes.diff(beforeMap).affectedKeys().hasOnly([sid])
            && after.subjectMinutes[sid] == beforeMap.get(sid, 0) + newSessionDuration(uid, after.lastSessionId);
      }

      function profileOk(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 40
          && data.universityId is string && data.universityId.size() > 0 && data.universityId.size() <= 40
          && data.universityName is string && data.universityName.size() > 0 && data.universityName.size() <= 80
          && (data.get('careerId', null) == null
              || (data.careerId is string && data.careerId.size() <= 60));
      }

      // Editar perfil: solo nombre y universidad
      function isProfileEdit() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'universityId', 'universityName', 'careerId', 'updatedAt']);
      }

      // Registrar sesión: los totales suben exactamente lo de la sesión nueva del mismo batch
      function isSessionUpdate(uid) {
        let after = request.resource.data;
        let before = resource.data;
        let minutes = newSessionDuration(uid, after.lastSessionId);
        return after.diff(before).affectedKeys().hasOnly([
            'totalMinutes', 'sessions', 'currentStreak', 'bestStreak',
            'lastSessionDate', 'lastSessionId', 'updatedAt', 'subjectMinutes'
          ])
          && subjectMinutesOk(uid)
          && minutes > 0
          && after.totalMinutes == before.totalMinutes + minutes
          && after.sessions == before.sessions + 1
          && after.currentStreak is int && after.currentStreak >= 0 && after.currentStreak <= after.sessions
          && after.bestStreak is int && after.bestStreak >= before.bestStreak && after.bestStreak <= after.sessions
          && after.lastSessionDate is string && after.lastSessionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      // Cualquier usuario con sesión puede leer perfiles (necesario para el ranking).
      // El correo no se guarda aquí, solo en Firebase Auth.
      allow read: if signedIn();

      allow create: if isOwner(uid)
        && keysOk(request.resource.data)
        && profileOk(request.resource.data)
        && request.resource.data.totalMinutes == 0
        && request.resource.data.sessions == 0
        && request.resource.data.currentStreak == 0
        && request.resource.data.bestStreak == 0
        && request.resource.data.lastSessionDate == null
        && request.resource.data.lastSessionId == null
        && !('premium' in request.resource.data)
        && !('subjectMinutes' in request.resource.data)
        && !('goals' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && keysOk(request.resource.data)
        && profileOk(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (isProfileEdit() || isSessionUpdate(uid) || isPremiumToggle() || isGoalsEdit()
            || isSubjectPrefsEdit());

      allow delete: if isOwner(uid);

      // ---------- Sesiones: users/{uid}/sessions/{sessionId} ----------
      match /sessions/{sessionId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['id', 'date', 'duration', 'type', 'time', 'subjectId', 'createdAt'])
          && request.resource.data.keys().hasAll(['id', 'date', 'duration', 'type', 'time', 'createdAt'])
          && sessionId.size() <= 40
          && request.resource.data.id == sessionId
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.duration is int
          && request.resource.data.duration > 0
          && request.resource.data.duration <= 60
          && request.resource.data.type == 'pomodoro'
          && request.resource.data.time is string
          && request.resource.data.time.size() <= 10
          && (!('subjectId' in request.resource.data)
              || (request.resource.data.subjectId is string
                  && request.resource.data.subjectId.matches('^[a-z0-9-]{1,40}$')))
          && request.resource.data.createdAt == request.time
          // Debe crearse junto con la actualización de totales del usuario
          && getAfter(userPath(uid)).data.lastSessionId == sessionId;

        // Las sesiones no se editan
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // ---------- Recordatorios: users/{uid}/reminders/{reminderId} ----------
      match /reminders/{reminderId} {
        function reminderOk(data) {
          return data.keys().hasOnly(['title', 'hour', 'minute', 'days', 'enabled', 'createdAt', 'updatedAt'])
            && data.keys().hasAll(['title', 'hour', 'minute', 'days', 'enabled', 'createdAt', 'updatedAt'])
            && data.title is string && data.title.size() > 0 && data.title.size() <= 40
            && data.hour is int && data.hour >= 0 && data.hour <= 23
            && data.minute is int && data.minute >= 0 && data.minute <= 59
            && data.days is list && data.days.size() >= 1 && data.days.size() <= 7
            && data.days.hasOnly([1, 2, 3, 4, 5, 6, 7])
            && data.enabled is bool
            && data.updatedAt == request.time;
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && reminderOk(request.resource.data)
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid)
          && reminderOk(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(uid);
      }

      // ---------- Dispositivos (token de push): users/{uid}/devices/{deviceId} ----------
      match /devices/{deviceId} {
        function deviceOk(data) {
          return data.keys().hasOnly(['token', 'platform', 'updatedAt'])
            && data.keys().hasAll(['token', 'platform', 'updatedAt'])
            && data.token is string && data.token.size() > 0 && data.token.size() <= 200
            && data.platform in ['android', 'ios']
            && data.updatedAt == request.time;
        }

        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && deviceId.size() <= 200 && deviceOk(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    // ---------- Universidades: universities/{universityId} ----------
    match /universities/{universityId} {
      function keysOk(data) {
        return data.keys().hasOnly(['name', 'students', 'totalMinutes', 'updatedAt']);
      }

      // +1 si el usuario entra a esta universidad, -1 si sale (o borra su cuenta), 0 si no cambia
      function studentsDelta() {
        let path = userPath(request.auth.uid);
        let wasHere = exists(path) && get(path).data.universityId == universityId;
        let isHere = existsAfter(path) && getAfter(path).data.universityId == universityId;
        return (isHere ? 1 : 0) - (wasHere ? 1 : 0);
      }

      // Minutos de la sesión nueva del usuario, si pertenece a esta universidad
      function minutesDelta() {
        let path = userPath(request.auth.uid);
        return existsAfter(path) && getAfter(path).data.universityId == universityId
          ? newSessionDuration(request.auth.uid, getAfter(path).data.lastSessionId)
          : 0;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && keysOk(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.students == studentsDelta()
        && request.resource.data.students >= 0
        && request.resource.data.totalMinutes == minutesDelta()
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && keysOk(request.resource.data)
        && request.resource.data.name == resource.data.name
        && request.resource.data.students == resource.data.students + studentsDelta()
        && request.resource.data.totalMinutes == resource.data.totalMinutes + minutesDelta()
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // ---------- Todo lo demás: bloqueado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
